{
  "name": "stress",
  "version": "3.1.0",
  "private": true,
  "description": "Stress: the three-minute strategy game. Raid the enemy half, rattle their pieces, crack their nerve.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "e2e": "node tools/e2e.js",
    "serve": "python3 -m http.server 8000",
    "build": "node tools/build.js",
    "ios": "node tools/build.js && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "icons": "node tools/icons.js",
    "shots": "node tools/store-shots.js",
    "puzzles:generate": "node tools/puzzles/generate.js",
    "puzzles:curate": "node tools/puzzles/curate.js",
    "puzzles:deep": "node tools/puzzles/deep.js",
    "puzzles:build": "node tools/puzzles/build.js",
    "puzzles:verify": "STRESS_PROVE_ALL=1 node --test tests/puzzles.test.js",
    "sim": "node tools/sim/sim.js"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
